# ── Shared ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-50-char-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# ── Database (per-service schemas on one cluster) ───────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bulkping
POSTGRES_USER=bulkping
POSTGRES_PASSWORD=bulkping

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# ── Evolution API ───────────────────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your-evolution-api-key
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_GLOBAL_URL=http://gateway/webhooks/evolution/

# ── DigitalOcean Spaces (optional for media) ────────────────────────────────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# ── Celery ──────────────────────────────────────────────────────────────────
CELERY_TIMEZONE=Asia/Kolkata

# ── Service URLs (internal Docker network) ──────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8001
INSTANCE_SERVICE_URL=http://instance-service:8002
CONTACTS_SERVICE_URL=http://contacts-service:8003
CAMPAIGNS_SERVICE_URL=http://campaigns-service:8004
CHATBOT_SERVICE_URL=http://chatbot-service:8005
WEBHOOK_SERVICE_URL=http://webhook-service:8006
